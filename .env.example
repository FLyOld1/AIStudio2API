# 账户状态文件、目录或逗号分隔的多个路径
AISTUDIO_AUTH_STATES=auth

# 服务监听地址
LISTEN_ADDR=127.0.0.1:2048

# 本地 API 认证密钥
PROXY_API_KEY=

# setup 与未指定账户共同使用的 HTTP、HTTPS 或 SOCKS5 代理
PROXY=

# 单账户初始化超时
INIT_TIMEOUT=2m

# 普通请求最大执行时间
REQUEST_TIMEOUT=5m

# 常驻预热账户数
WARM_WORKER_LIMIT=5

# 高峰期最多同时运行的 Worker 数
MAX_ACTIVE_WORKERS=10

# 服务启动时同时预热的账户数
WARM_STARTUP_CONCURRENCY=2

# 单账号同时处理的请求数
PER_ACCOUNT_CONCURRENCY=2

# 账户选择策略：round-robin 或 fill-first
ROUTING_STRATEGY=round-robin

# 生成请求使用的上游通道：playground、build，逗号分隔
UPSTREAM_CHANNELS=playground,build

# WAA 后端：camoufox 使用 Camoufox 页面，go 在服务进程内运行
WAA_BACKEND=camoufox

# WAA 预热是否使用临时对话
TEMPORARY_CHAT=false

# 公网管理接口密钥：非回环访问管理接口必须携带（X-Admin-Key 或 ?key=）；本机回环访问无需
ADMIN_API_KEY=

# 是否允许非回环地址访问管理接口（需同时设置 ADMIN_API_KEY）
ADMIN_REMOTE_ACCESS=false

# 是否把 /v1 与 /v1beta 请求的入参和出参写入日志文件
REQUEST_LOG_ENABLED=true

# 请求日志目录（相对路径基于程序工作目录）
REQUEST_LOG_DIR=logs

# 单个请求日志文件上限（MB），超过后轮转新文件
REQUEST_LOG_MAX_FILE_MB=32

# 请求日志目录总量上限（MB），超过后从最旧文件开始删除
REQUEST_LOG_MAX_TOTAL_MB=512

# 请求日志保留天数，超过后自动删除
REQUEST_LOG_RETENTION_DAYS=7

# 单条请求正文与响应正文的截断上限（KB）
REQUEST_LOG_BODY_LIMIT_KB=256
